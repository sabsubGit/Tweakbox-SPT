  // White flares are pure illumination (FlareTypes is empty - no airdrop, no
  // extract trigger), which makes them the one flare worth carrying for night
  // raids. Vanilla leaves them flea-only at ~21k base, so they were never worth
  // buying. Jaeger sells them outright now, with the flea price cut to match.
  "traderStock": {
    "enabled": true,
    "entries": [
      {
        "trader": "Jaeger",
        "id": "62389bc9423ed1685422dc57",
        "comment": "26x75mm flare cartridge (White) - SP-81 flare gun round",
        "priceRub": 8129,
        "loyaltyLevel": 1
      },
      {
        "trader": "Jaeger",
        "id": "62178be9d0050232da3485d9",
        "comment": "ROP-30 reactive flare cartridge (White) - handheld, single use",
        "priceRub": 10188,
        "loyaltyLevel": 1
      },
      {
        // Jaeger already lists this at LL2, but only as a barter for Aquapeps
        // tablets - a ~27,000 RUB item traded for a 6,213 RUB flare, which is
        // why nobody ever notices it. This is the same offer for cash, priced
        // in line with his RSP-30 green at 6,019.
        "trader": "Jaeger",
        "id": "62389aaba63f32501b1b444f",
        "comment": "26x75mm flare cartridge (Green) - SP-81 round, activates flare extracts",
        "priceRub": 6524,
        "loyaltyLevel": 2
      },
      {
        // Ref sells it (WTT-ContentBackport) for GP coins; this is the dollar option.
        // Priced at its handbook value (38,050 RUB / 121 per dollar), same 3-per-restock limit as Ref.
        "trader": "Peacekeeper",
        "id": "68bf405779c8186398099017",
        "comment": "Peltor TEP-300 tactical earplug (Coyote Brown)",
        "currency": "USD",
        "price": 315,
        "loyaltyLevel": 3,
        "buyRestrictionMax": 3
      },
      {
        // IDEA ISKUB lingonberry soda (custom item, see customItems) - barter only.
        "trader": "Therapist",
        "id": "6a1a5cb0d11dea1a1150da01",
        "comment": "IDEA ISKUB lingonberry soda (barter)",
        "loyaltyLevel": 3,
        "barter": [ { "id": "5b4335ba86f7744d2837a264", "count": 1 } ] // Medical bloodset
