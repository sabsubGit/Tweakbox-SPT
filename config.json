  // New items, cloned from an existing item and re-skinned. Each entry is SPT's standard
  // "new item from clone" format. They are created before everything else below, so the trader
  // stock and loot injection sections can sell or spawn them by their "newId".
  // The models/textures ship in this mod's bundles/ folder (see bundles.json); the server hands
  // them to every connecting client, so friends don't install anything extra for them.
  "customItems": {
    "enabled": true,
    "items": [
      {
        // IDEA ISKUB lingonberry soda - the water bottle with a new model and label.
        // Same 1x2 size, same drinking animation and sound as the water bottle.
        "newId": "6a1a5cb0d11dea1a1150da01",
        "newItemName": "item_drink_iskub",
        "itemTplToClone": "5448fee04bdc2dbc018b4567",
        "parentId": "5448e8d64bdc2dce718b4568",
        "handbookParentId": "5b47574386f77428ca22b335",
        "handbookPriceRoubles": 14000,
        "fleaPriceRoubles": 30000,
        "overrideProperties": {
          "Prefab": { "path": "assets/content/weapons/usable_items/item_iskub/item_iskub_loot.bundle", "rcid": "" },
          "UsePrefab": { "path": "assets/content/weapons/usable_items/item_iskub/item_iskub_container.bundle", "rcid": "" },
          "Weight": 0.55,
          "effects_health": {
            "Hydration": { "value": 80 }
          }
        },
        "locales": {
          "en": {
            "name": "IDEA ISKUB lingonberry soda",
            "shortName": "Iskub",
            "description": "A sparkling lingonberry soda from IDEA. Sweet, fizzy and tart, and by most accounts the best sugary drink still on the shelves in Tarkov, which isn't the compliment it used to be, but it still counts."
