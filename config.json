  // Makes an item spawn wherever some existing items already can: loose loot spots,
  // static containers and scav/boss/follower inventories that can hold any of "likeItems"
  // get it too, weighted like the rarest look-alike present there (times weightFactor).
  // PMCs need no entry: SPT builds their bag loot from every drink, weighted by flea price.
  "spawnLike": {
    "enabled": true,
    "entries": [
      {
        "id": "6a1a5cb0d11dea1a1150da01",
        "comment": "IDEA ISKUB lingonberry soda",
        "likeItems": [
          "5448fee04bdc2dbc018b4567", // Bottle of water (0.6L)
          "5e8f3423fd7471236e6e3b64"  // Norvinsky Yadreniy premium kvass
        ],
        "weightFactor": 1.0
      }
